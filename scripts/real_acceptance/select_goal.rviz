Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 70; 70; 70
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Saved Map
      Enabled: true
      Alpha: 1
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Draw Behind: false
    - Class: rviz_default_plugins/Grid
      Name: Metre Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      Color: 128; 128; 128
      Alpha: 0.3
    - Class: rviz_default_plugins/Marker
      Name: Selected Goal Coordinates
      Enabled: true
      Topic:
        Value: /acceptance/selected_goal_marker
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /acceptance/selected_goal
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 1
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: map
      Scale: 65
      X: 0
      Y: -2
      Angle: 0
  Enabled: true
Window Geometry:
  Width: 1280
  Height: 900
  X: 30
  Y: 30
