Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 70; 70; 70
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Alpha: 1
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Draw Behind: false
    - Class: rviz_default_plugins/LaserScan
      Name: Live Obstacles
      Enabled: true
      Topic:
        Value: /obstacle_scan
        Reliability Policy: Best Effort
        Depth: 5
      Size (m): 0.04
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 60; 60
    - Class: rviz_default_plugins/Path
      Name: Planned Path
      Enabled: true
      Topic:
        Value: /plan
        Depth: 1
      Color: 0; 220; 255
      Line Style: Lines
      Line Width: 0.04
    - Class: rviz_default_plugins/Map
      Name: Live Local Costmap
      Enabled: true
      Topic:
        Value: /local_costmap/costmap
        Durability Policy: Transient Local
        Depth: 1
      Color Scheme: costmap
      Alpha: 0.35
    - Class: rviz_default_plugins/Axes
      Name: Chassis Axes
      Enabled: true
      Reference Frame: base_footprint
      Length: 0.4
      Radius: 0.025
    - Class: rviz_default_plugins/Axes
      Name: Gimbal Axes
      Enabled: true
      Reference Frame: gimbal_yaw
      Length: 0.6
      Radius: 0.012
    - Class: rviz_default_plugins/Grid
      Name: Metre Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      Color: 128; 128; 128
      Alpha: 0.3
    - Class: rviz_default_plugins/Marker
      Name: Selected Goal Coordinates
      Enabled: true
      Topic:
        Value: /acceptance/selected_goal_marker
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /acceptance/selected_goal
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 1
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: map
      Scale: 65
      X: 0
      Y: -2
      Angle: 0
  Enabled: true
Window Geometry:
  Width: 1280
  Height: 900
  X: 30
  Y: 30
